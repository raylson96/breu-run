{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron-sync-races",
      "schedule": "0 8 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/cron/sync-races", "destination": "/api/cron-sync-races" },
    { "source": "/((?!api/.*).*)", "destination": "/index.html" }
  ]
}
